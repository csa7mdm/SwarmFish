# SwarmFish — Environment Variables
# Copy this to .env.local and fill in your values

# LLM Configuration (any OpenAI-compatible API)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL_NAME=claude-sonnet-4-6

# Zep Cloud (free tier: https://app.getzep.com)
ZEP_API_KEY=your_zep_api_key_here

# KuzuDB (embedded, just a file path)
KUZU_DB_PATH=./data/kuzu

# Orleans clustering
ORLEANS_CLUSTER_ID=swarmfish
ORLEANS_SERVICE_ID=swarmfish-dev

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5001
